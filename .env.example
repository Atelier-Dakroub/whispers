# Signs the session cookie. Any long random string; `openssl rand -base64 32`
# writes one. Changing it signs everybody out, which is what a signature means.
COOKIE_SECRET=replace-me-with-something-random

# Which database. `libsql` is the default and needs nothing installed beyond
# what ships here; it reads a file, or a Turso URL.
#   libsql          file:./data/whispers.db, or libsql://… for Turso
#   better-sqlite3  ./data/whispers.db
#   postgres        postgres://user:pass@host/db   (npm install postgres)
# Cloudflare D1 is not set here — worker.js wires it from the binding.
DB_DRIVER=libsql
DATABASE_URL=file:./data/whispers.db
# DATABASE_AUTH_TOKEN=   # Turso only

# The origin the feed and canonical URLs are built from.
SITE_URL=http://localhost:1960

# Optional. With a key, a submitted link is checked against Google Safe
# Browsing and a match shows a warning in the admin. Without one, that check is
# skipped and nothing else changes.
# GOOGLE_SAFE_BROWSING_API_KEY=
