{
  "name": "whispers.news",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import ./db.node.js node_modules/.bin/transclude-dev",
    "build": "transclude-build",
    "start": "node --env-file-if-exists=.env --import ./db.node.js node_modules/.bin/transclude-serve",
    "preview": "npm run build && npm start",
    "check": "transclude-check",
    "pretest": "npm run build && node --env-file=.env.test scripts/reset.js --yes && node --env-file=.env.test scripts/migrate.js",
    "test": "node --test --env-file=.env.test --import ./db.node.js \"test/**/*.test.js\"",
    "db:generate": "npm run db:generate:sqlite && npm run db:generate:pg",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.config.sqlite.js",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:reset": "node --env-file-if-exists=.env scripts/reset.js",
    "member:list": "node --env-file-if-exists=.env scripts/member.js list",
    "member:add": "node --env-file-if-exists=.env scripts/member.js add",
    "member:reset": "node --env-file-if-exists=.env scripts/member.js reset",
    "start:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:demo": "npm run build && wrangler deploy -c wrangler.demo.jsonc",
    "db:migrate:demo": "wrangler d1 migrations apply whispers-demo --remote -c wrangler.demo.jsonc"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@transclude/core": "^0.10.2",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9",
    "vite": "^8",
    "wrangler": "^4.120.0"
  },
  "description": "A headline-only news site with a signed-in admin. Server-rendered HTML, no client bundle.",
  "optionalDependencies": {
    "postgres": "^3.4.7"
  }
}
